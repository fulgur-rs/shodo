  "limitations": [
    "This is a targeted warm-build experiment, not a whole-page or all-font speed guarantee.",
    "Per-iteration output is not hashed inside the timed build loop; geometry, glyph ownership, paint and selection digests from the prepared build are compared across all processes, and the test suite separately verifies behavior.",
    "Small timing ratios near one can reflect scheduling and thermal variation.",
    "Cache lookup and bounded temporary allocations add cost when no bounds repeat; raw bounds and nominal probes are retained only until this build finishes.",
    "High shared-machine load produced large elapsed-time variation; elapsed ratios are diagnostic and should not be treated as a stable speed guarantee. Hardware instruction slopes provide the primary CPU-work evidence."
  ],
  "reproduction": {
    "build": "TMPDIR=\"$HOME/tmp\" CARGO_TARGET_DIR=\"$measurement_dir/target\" cargo build --offline --locked --release -p shodo-bench --example source_geometry [--features allocation-counting]",
    "run": "taskset -c 10 \"$binary\" build \"$case\" \"$scale\" \"$iterations\"",
    "baseline": "Build each variant at the recorded base revision and patch under the same toolchain, lockfile and features. Save each executable before changing build features.",
    "cleanup": "Temporary target directory, four saved executables and validation logs are removed after recording results and merging the PR."
  },
  "conclusion": {
    "cpu_work": "Japanese cases show approximately 14–15% fewer estimated instructions per warm paragraph build; geometry/glyph, paint and selection digests match in every measured process.",
    "controls": "Latin/Arabic/plain controls increase estimated instructions by at most 0.44%; mixed scripts decreases by 1.68%.",
    "memory": "Japanese builds add three temporary allocation calls and 684 requested bytes per build; Latin/Arabic/plain controls add one temporary call and 352 bytes. No additional net retention after build/drop.",
    "timing": "Elapsed results are retained for transparency but shared-machine load prevents a stable wall-time speed claim.",
    "cache_scope": "Only paragraph construction. At most eight font/size/coordinate entries with at most 64 raw glyph bounds per entry. Coordinates are borrowed; no cache retained by the paragraph or context."
  },
