{
  "issue": "shodo-t3t",
  "decision": "adopted",
  "baseline_commit": "3334beaf53fa683ab4ee9803b5b413a1b187ad00",
  "candidate_commit": "4433a11058f67b08b59e394af858878556534738",
  "pre_fix_commit": "ad9d4d6ed66b314c7eeb425dc167c6e691ed9e7e",
  "candidate_change": "Paragraphs with Ruby reuse the selected text-combine-upright width-probe trial output instead of shaping each group a third time, when each group input is one window under scoped and global run budgets and a non-mutating BaseScope preflight passes; otherwise the group is reshaped through the scoped path. The preflight compares each touched scope's spent glyphs plus the saturated sum of the charges reaching it: O(charges + depth) for a single owner, O(charges * depth) otherwise.",
  "binaries": {
    "baseline_sha256": "6a40674f2c6e5b65ec8c5420220591143b52eda10ec52b41f938a4181f69ebe6",
    "candidate_sha256": "e60a08aec0f7fa0a0df106f414a686c08f8e1c433b402404c8d653d75fbb7070",
    "baseline_alloc_sha256": "45286b1094187e5f1ccbee7512cebc641f7d793dcd8f22f7430df67e7c221054",
    "candidate_alloc_sha256": "c288be0de9550ec22f0760a65c1913249cc81a752787c20a230b5de9b50d5cf0",
    "pre_fix_sha256": "49ce5d5a7b4085a9afc33b0d0dcb1f2f303eb7dc049f6adf1b87664fdfb49a11",
    "note": "Separate release builds with separate target directories; the baseline worktree is 3334bea plus the probe example and its [[example]] entry. Timing binaries are built without features; *_alloc binaries add --features allocation-counting and are used only for the alloc subcommand. pre_fix is ad9d4d6 (before the per-scope-total preflight) plus the same probe."
  },
  "environment": {
    "rustc": "1.96.0 (ac68faa20 2026-05-25)",
    "host": "x86_64-unknown-linux-gnu",
    "cpu": "AMD Ryzen 5 5600G with Radeon Graphics",
    "scaling_governor": "performance",
    "cpu_boost": "enabled"
  },
  "probe": {
    "command": "cargo run --release -p shodo-bench --example tcy_base_reuse -- sample <case> <label> <index> <builds>",
    "alloc_command": "cargo run --release -p shodo-bench --features allocation-counting --example tcy_base_reuse -- alloc <case> <label> <builds>",
    "fonts": "shodo-fixtures FONTS[1] (CJK) for TCY wrappers and annotation, FONTS[0] (Latin, 19px) for separators; deep-nested-multi styles TCY as [Latin, CJK] so each \"1日2日\" group has four shape inputs",
    "annotation": "\"日\" (the fixture CJK font lacks \"注\", which geometry_snapshot rejects as a missing glyph)",
    "timed_region": "ParagraphBuilder::build only; builders and LayoutContexts are prepared before timing, and font loading, warm-up build, break_all, digests, and warning collection are outside the timer",
    "sample_value": "total build time divided by builds_per_sample; per-round values average the two samples of each label",
    "deep_nested_digest": "break_all on 250 nested ruby levels takes about 15-25 s per paragraph (outside the timer, same in both binaries), so deep-nested-multi timing samples skip the digest; the smoke run and every alloc build compared digests",
    "output_and_warning_equivalence": "Every digested sample of every case in both runs had one output digest and one warning digest shared by baseline and candidate; smoke and alloc digests also matched for all cases."
  },
